          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Vehicle to MaintenanceLog -->
        <mxCell id="rel_vehicle_maint" value="1:N (maintenance)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#d97706;strokeWidth=2;" edge="1" parent="1" source="ent_vehicle" target="ent_maint">
          <mxGeometry relative="1" as="geometry" />
