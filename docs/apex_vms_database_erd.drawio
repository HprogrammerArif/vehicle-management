        <!-- ==================== ENTITY: FUEL LOG ==================== -->
        <mxCell id="ent_fuel" value="&lt;b&gt;FuelLog (Anti-Theft Audit)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id: String [cuid]&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; vehicleId: String [Vehicle]&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; driverId: String [Driver]&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; tripId: String? [Trip]&lt;br&gt;odometerReading: Float&lt;br&gt;fuelAdded: Float [Liters]&lt;br&gt;pricePerLiter: Float&lt;br&gt;totalCost: Float&lt;br&gt;receiptPhoto: String [Cloudinary URL]&lt;br&gt;stationName: String?&lt;br&gt;consumptionRate: Float? [calc km/L]&lt;br&gt;&lt;b&gt;isAnomaly: Boolean [Fraud Flag]&lt;/b&gt;&lt;br&gt;loggedAt: DateTime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
