        <!-- ==================== ENTITY: TRACKING POINT ==================== -->
        <mxCell id="ent_tracking" value="&lt;b&gt;TrackingPoint (GPS Breadcrumb)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id: String [cuid]&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; tripId: String [Trip]&lt;br&gt;driverId: String&lt;br&gt;latitude: Float&lt;br&gt;longitude: Float&lt;br&gt;speed: Float? [km/h]&lt;br&gt;heading: Float? [0-360°]&lt;br&gt;timestamp: DateTime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="140" width="260" height="150" as="geometry" />
