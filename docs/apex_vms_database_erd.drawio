        <!-- Legend -->
        <mxCell id="legend_box" value="&lt;b&gt;Architecture Legend&lt;/b&gt;&lt;br&gt;🔵 &lt;font color='#0284c7'&gt;Master / Org Entities&lt;/font&gt; | 🟢 &lt;font color='#059669'&gt;Trips &amp;amp; Operations&lt;/font&gt; | 🟠 &lt;font color='#d97706'&gt;Telemetry &amp;amp; Auditing&lt;/font&gt; | 🟣 &lt;font color='#7c3aed'&gt;Communications&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="600" height="35" as="geometry" />
