        <!-- ==================== ENTITY: OFFICE ==================== -->
        <mxCell id="ent_office" value="&lt;b&gt;Office&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id: String [cuid]&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; organizationId: String&lt;br&gt;name: String&lt;br&gt;type: String [HQ|REGIONAL|FACTORY|BRANCH]&lt;br&gt;address: String&lt;br&gt;latitude: Float?&lt;br&gt;longitude: Float?&lt;br&gt;createdAt: DateTime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
